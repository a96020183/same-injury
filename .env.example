# Copy to .env and fill in. Never commit .env. SAMPLE_MODE=true needs none of the keys below.
SAMPLE_MODE=true

# Meterless Nightshift (the only model provider). The NVIDIA key lives in Nightshift's Providers, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=<your Nightshift runtime token>
# optional lane overrides (defaults shown)
# L1_MODEL_DEEP=nvidia/nemotron-3-super-120b-a12b
# L1_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# L1_MODEL_VISION=meterless/vision
# L1_MODEL_OFFLINE=false

# Zetaris (local Docker)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=<your Zetaris administrator API key (reviewer: COMPILE USL after approval)>
# the agents' own non-admin key; scripts/setup_governance.py creates it in data/private/ if this is empty
ZETARIS_AGENT_API_KEY=

# DOL enforcement API (only for rebuilding the DOL snapshot; the app reads the snapshot through Zetaris)
DOL_API_KEY=<your DOL API key>

# PORT=8740                 (if busy, the app tries the next ten ports)
# L1_SAMPLE_DIR=           (another sample folder, e.g. one with renamed sources)
